# ==============================================================================
# NEXORA ENVIRONMENT CONFIGURATION (LOCAL / STAGING / PROD)
# ==============================================================================

# 1. Firebase Web Configuration (Create a fresh project at https://console.firebase.google.com)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-nexora-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-nexora-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-nexora-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# 2. AI Providers
# Primary: OpenRouter (https://openrouter.ai) — indexed keys for rotation
OPENROUTER_API_KEY_1=your_openrouter_api_key_1
OPENROUTER_API_KEY_2=your_openrouter_api_key_2
# ... add OPENROUTER_API_KEY_3 .. OPENROUTER_API_KEY_16 the same way ...
OPENROUTER_API_KEYS=comma,separated,list,of,all,keys
OPENROUTER_ACTIVE_KEY_INDEX=1
# Paid routers (e.g. openrouter/auto) can answer 402 "Payment Required" for every
# key when the account is out of credits. Use "openrouter/free" (a zero-credit
# router) as the primary or fallback so the resume audit keeps working.
OPENROUTER_MODEL=openrouter/auto
# Comma-separated model chain tried after OPENROUTER_MODEL. First win wins.
OPENROUTER_FALLBACK_MODELS=openrouter/free
# Cap on generated output tokens. OpenRouter otherwise defaults to the model's
# max (e.g. 131072), which makes budget accounts answer 402 even for tiny
# outputs. Set to "" to disable the cap.
OPENROUTER_MAX_TOKENS=8192

# Fallback: Groq (https://console.groq.com)
GROQ_API_KEYS=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Optional: Gemini (used as another fallback if configured)
GEMINI_API_KEYS=

# Optional: app branding sent to OpenRouter (improves rate-limit routing)
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
NEXT_PUBLIC_APP_NAME=NEXORA

# 3. Automated Opportunity Ingestion (Cron secret — Vercel Cron sends this as a Bearer token)
CRON_SECRET=your_random_secret

# 4. Firebase Admin SDK Service Account Key
# In production (Vercel): paste the full JSON string of your Firebase service account.
# In local development: place your new service account JSON in scripts/serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_PROJECT_ID=your-nexora-project

# 5. Cloudinary Credentials (For Document Wallet - https://cloudinary.com)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 6. Admin access
# Comma-separated list of emails allowed to hold the admin role. An allow-listed
# email ALSO has to be email_verified, because Firebase issues ID tokens for
# unverified accounts. When unset, src/lib/serverAuth.ts falls back to its
# built-in FALLBACK_ADMIN_EMAILS list.
ADMIN_EMAILS=

# Optional: GitHub personal access token for the Performance Tracker's profile
# enrichment (repo stars/forks/commits). Raises the unauthenticated API limit of
# 60 requests/hour to 5000/hour. Create a fine-grained token at
# https://github.com/settings/tokens — no scopes are strictly required for public
# data. Leave blank to run unauthenticated (slower, fewer repos sampled).
GITHUB_TOKEN=

# 7. Outbound request deadlines (milliseconds, optional)
# Caps how long a single outbound request may hang before it is aborted. Without
# these an upstream that accepts a connection and never answers burns the whole
# serverless request budget and returns a 504 instead of a partial result.
AI_REQUEST_TIMEOUT_MS=45000
# Hard ceiling for an entire AI routing attempt across all providers and keys.
# Stops provider fallback chains from blowing past the platform function timeout
# (which surfaces as a 504 with no body). Keep it below the route maxDuration.
AI_TOTAL_TIMEOUT_MS=120000
GITHUB_FETCH_TIMEOUT_MS=10000
CODING_FETCH_TIMEOUT_MS=10000
