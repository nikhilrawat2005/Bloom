# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. `.env.example` is committed on purpose — it documents every variable
# the app needs and must never contain a real secret.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Firebase service account (seed script) - NEVER commit this
scripts/serviceAccountKey.json
public/serviceAccountKey*.json

# scraped storage. These are runtime caches regenerated by the ingestion and
# summarize pipelines — committing them meant every scrape produced a multi-hundred-KB
# diff and the AI-bought summaries were reviewed line by line.
storage/*.json
!/storage/.gitkeep

# Downloaded Firebase service account JSON
*firebase-adminsdk*.json
