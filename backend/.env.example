# ── Server ────────────────────────────────────────────────────────────────
PORT=4000

# ── Firebase Admin ───────────────────────────────────────────────────────
# Paste the FULL contents of your Firebase service account JSON as a
# single-line string here (same key used by the Next.js app in production).
# For local dev you can instead drop the file at ./serviceAccountKey.json
# and leave this blank — deadlineChecker.js will fall back to it.
FIREBASE_SERVICE_ACCOUNT_KEY=

# ── Gmail SMTP (Nodemailer) ──────────────────────────────────────────────
# Use a Gmail App Password, NOT your normal Gmail password.
# Generate one at: https://myaccount.google.com/apppasswords
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Display name used as the "From" header
EMAIL_FROM_NAME=Bloom Opportunity Tracker

# ── Cron schedule ─────────────────────────────────────────────────────────
# Standard cron syntax, runs in server's local time zone.
# Default: every day at 08:00
DEADLINE_CHECK_CRON=0 8 * * *

# App URL used to build "View in Tracker" links inside the email
APP_URL=http://localhost:3000
